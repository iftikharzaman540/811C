generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
  BLOCKED
  SUSPENDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  BET
  WIN
  BONUS
  REFUND
  ADJUSTMENT
}

enum FinancialStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum SessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

model User {
  id            String    @id @default(uuid())
  username      String?   @unique
  email         String?   @unique
  phone         String?   @unique
  password_hash String
  role          Role      @default(USER)
  status        Status    @default(ACTIVE)
  avatar        String?
  country       String?
  referral_code String?   @unique
  
  current_wagering_requirement Decimal @default(0.00) @db.Decimal(15, 2)
  current_wagering_completed   Decimal @default(0.00) @db.Decimal(15, 2)

  available_spins Int @default(0)
  has_registration_spin Boolean @default(false)
  last_login_spin_date DateTime?
  has_claimed_promotion Boolean @default(false)

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  wallet        Wallet?
  deposits      Deposit[]
  withdrawals   Withdrawal[]
  game_history  GameHistory[]
  sessions      GameSession[]
  referrals     Referral[]  @relation("ReferredUsers")
  referrer      Referral?   @relation("UserReferrer")
  audit_logs       AuditLog[] @relation("UserAuditLogs")
  admin_audit_logs AuditLog[] @relation("AdminAuditLogs")
  payments         Payment[]
  notifications    Notification[]

  @@index([username])
  @@index([email])
  @@index([phone])
}

model Wallet {
  id            String    @id @default(uuid())
  user_id       String    @unique
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  balance       Decimal   @default(0.00) @db.Decimal(15, 2)
  bonus_balance Decimal   @default(0.00) @db.Decimal(15, 2)
  currency      String    @default("PKR")
  
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  transactions  WalletTransaction[]

  @@index([user_id])
}

model WalletTransaction {
  id             String          @id @default(uuid())
  wallet_id      String
  wallet         Wallet          @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  type           TransactionType
  amount         Decimal         @db.Decimal(15, 2)
  balance_before Decimal         @db.Decimal(15, 2)
  balance_after  Decimal         @db.Decimal(15, 2)
  reference_id   String?         @unique
  description    String?
  
  created_at     DateTime        @default(now())

  @@index([wallet_id])
  @@index([created_at])
  @@index([type])
}

model Deposit {
  id                  String          @id @default(uuid())
  user_id             String
  user                User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  amount              Decimal         @db.Decimal(15, 2)
  payment_method      String
  transaction_ref     String?         @unique
  proof_image         String?
  status              FinancialStatus @default(PENDING)
  
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  @@index([user_id])
  @@index([status])
}

model Withdrawal {
  id                  String          @id @default(uuid())
  user_id             String
  user                User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  amount              Decimal         @db.Decimal(15, 2)
  payment_method      String
  account_details     String
  status              FinancialStatus @default(PENDING)
  
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  @@index([user_id])
  @@index([status])
}

// PHASE 2 - GAME PLATFORM CORE

model GameCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  status      Status   @default(ACTIVE)
  
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  games       Game[]
}

model Game {
  id               String       @id @default(uuid())
  name             String
  slug             String       @unique
  description      String?
  thumbnail        String?
  banner_image     String?
  category_id      String
  category         GameCategory @relation(fields: [category_id], references: [id])
  provider         String
  provider_game_id String       @unique
  status           Status       @default(ACTIVE)
  is_featured      Boolean      @default(false)
  
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  
  history          GameHistory[]
  sessions         GameSession[]

  @@index([category_id])
  @@index([slug])
  @@index([is_featured])
  @@index([status])
  @@index([provider])
}

model GameSession {
  id            String        @id @default(uuid())
  user_id       String
  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  game_id       String
  game          Game          @relation(fields: [game_id], references: [id])
  session_token String        @unique
  provider      String
  status        SessionStatus @default(ACTIVE)
  
  created_at    DateTime      @default(now())

  @@index([user_id])
  @@index([session_token])
}

model GameHistory {
  id                    String   @id @default(uuid())
  user_id               String
  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  game_id               String
  game                  Game     @relation(fields: [game_id], references: [id])
  bet_amount            Decimal  @db.Decimal(15, 2)
  win_amount            Decimal  @db.Decimal(15, 2)
  result                String   // WIN, LOSS, TIE
  transaction_reference String?  @unique
  
  created_at            DateTime @default(now())

  @@index([user_id])
  @@index([game_id])
  @@index([created_at])
}

// END PHASE 2

model Referral {
  id               String   @id @default(uuid())
  user_id          String   @unique
  user             User     @relation("UserReferrer", fields: [user_id], references: [id])
  referred_user_id String
  referred_user    User     @relation("ReferredUsers", fields: [referred_user_id], references: [id])
  commission       Decimal  @default(0.00) @db.Decimal(15, 2)
  
  created_at       DateTime @default(now())

  @@index([user_id])
}

model AuditLog {
  id          String   @id @default(uuid())
  admin_id    String?
  admin       User?    @relation("AdminAuditLogs", fields: [admin_id], references: [id])
  user_id     String?
  user        User?    @relation("UserAuditLogs", fields: [user_id], references: [id])
  action      String
  entity      String
  entity_id   String?
  old_value   Json?
  new_value   Json?
  ip_address  String?
  
  created_at  DateTime @default(now())

  @@index([admin_id])
  @@index([user_id])
  @@index([action])
  @@index([entity])
}

// PHASE 4 - PAYMENTS AND NOTIFICATIONS

enum PaymentProvider {
  JAZZCASH
  EASYPAISA
  MANUAL
}

enum PaymentType {
  DEPOSIT
  WITHDRAWAL
}

model Payment {
  id                    String          @id @default(uuid())
  user_id               String
  user                  User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  amount                Decimal         @db.Decimal(15, 2)
  currency              String          @default("PKR")
  provider              PaymentProvider
  type                  PaymentType
  transaction_reference String          @unique
  status                FinancialStatus @default(PENDING)
  metadata              Json?
  
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  @@index([user_id])
  @@index([transaction_reference])
  @@index([status])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  message    String
  is_read    Boolean  @default(false)
  type       String   // e.g. DEPOSIT_APPROVED, WALLET_UPDATED
  
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([is_read])
}
